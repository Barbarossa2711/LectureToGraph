NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Provider keys -----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Private cluster (optional, OpenAI-compatible) ---------------------------
# Leave CLUSTER_BASE_URL empty to hide the provider from the UI.
# For an OpenWebUI gateway the URL has to end in /api/v1; check with
#   GET <CLUSTER_BASE_URL>/models   -> must return JSON, not <!doctype html>
CLUSTER_BASE_URL=
CLUSTER_API_KEY=
CLUSTER_LABEL=Hochschul-Cluster
CLUSTER_MODEL=moonshotai/Kimi-K2.7
CLUSTER_MODEL_FAST=
# Path to the server certificate when the endpoint is self-signed.
# Inside Docker use the mounted path, e.g. /certs/cluster_ca.pem
CLUSTER_CA_BUNDLE=
# Last resort only; disables certificate checking entirely.
CLUSTER_VERIFY_SSL=true
